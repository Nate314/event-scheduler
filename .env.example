# Optional. run.sh / run.ps1 generate a .env with a free port automatically.
# Copy to .env to pin values by hand. Without a .env, docker compose uses the
# defaults below (dev-only secrets: change them for anything but local use).
CLIENT_PORT=8080

# Read by the server (and used to create the MySQL app user on first start).
DB_USER=eventscheduler_app
DB_PASSWORD=dev-only-app-password-change-me
JWT_SECRET=dev-only-jwt-secret-change-me
MYSQL_ROOT_PASSWORD=dev-only-root-password-change-me
